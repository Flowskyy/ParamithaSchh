/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model homepage_sections {
  id          String   @id
  label       String?
  component   String?
  order_index Int?
  is_active   Boolean? @default(true)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model jadwal_ppdb {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nama            String
  tanggal_mulai   DateTime? @db.Date
  tanggal_selesai DateTime? @db.Date
  status          String?   @default("akan_datang")
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model jurusan {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name           String
  slug           String    @unique
  short_desc     String?
  icon           String?
  image_url      String?
  content        String?
  order_index    Int?      @default(0)
  created_at     DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  description    String?
  kompetensi     String[]
  prospek        String[]
  fasilitas      String[]
  gallery        String[]
  warna_primer   String?   @default("#C0161C")
  warna_sekunder String?   @default("#A01218")
  singkatan      String?
  aktif          Boolean?  @default(true)
  sekolah        String?   @default("paramitha2")
  materi         Json?     @default("[]")
  activities     Json?     @default("[]")
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mitra_perusahaan {
